# Spotify app credentials.
#
# Create an app at https://developer.spotify.com/dashboard, add your redirect
# URI to it (it must match exactly, including the trailing slash), then copy
# this file to `.env.local`.
#
# Without these the game still runs: it falls back to the mock playlist for
# driving, and to a stand-in library so the classifier and review screen can
# still be exercised.

VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
